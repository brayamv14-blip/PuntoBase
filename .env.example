# ───────────────────────── PuntoBase: variables de entorno ─────────────────────────
# Copia este archivo a .env.local (local) y configura las mismas variables en Vercel
# (Project → Settings → Environment Variables). NUNCA subas .env.local al repositorio.

# Supabase (PostgreSQL)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
# Publica (visible en el navegador). Con la migración 5 (RLS activado) no da acceso a los datos.
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# SECRETA: solo servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Notificaciones push (genera el par UNA sola vez con: npx web-push generate-vapid-keys)
# La pública va al navegador; la privada solo al servidor. Deben ser del MISMO par.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# Cloudinary (imágenes de productos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
